# Copier vers .env.local et renseigner via Firebase Console → Paramètres du projet

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Super admin unique (virgule si plusieurs)
NEXT_PUBLIC_SUPER_ADMIN_EMAILS=jonathan.seroussi.92100@gmail.com

# Compte de service Firebase — requis pour supprimer aussi Auth à la suppression d'un user
# Firebase Console → Paramètres projet → Comptes de service → Générer une clé privée
# Puis : [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes((Get-Content key.json -Raw)))
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=

# Prise de RDV (Resend) — https://resend.com
# Verifier le domaine lockin-web.online, puis mettre un from du type :
# RESEND_FROM_EMAIL=LockinIA <noreply@lockin-web.online>
RESEND_API_KEY=
RESEND_FROM_EMAIL=LockinIA <onboarding@resend.dev>
BOOKING_TO_EMAIL=contact@lockin-web.online
