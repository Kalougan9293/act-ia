rules_version = '2';

/**
 * Isolation multi-tenant LockinIA
 * Super admin = uniquement jonathan.seroussi.92100@gmail.com
 */
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function allowedSuperAdminEmail() {
      return request.auth.token.email == "jonathan.seroussi.92100@gmail.com";
    }

    function isSuperAdmin() {
      return hasProfile()
        && userDoc().role == "super_admin"
        && allowedSuperAdminEmail();
    }

    function isRh() {
      return hasProfile() && userDoc().role == "rh";
    }

    function isPartner() {
      return hasProfile()
        && userDoc().role == "partner"
        && userDoc().partnerId is string
        && userDoc().partnerId.size() > 0;
    }

    function myPartnerId() {
      return userDoc().partnerId;
    }

    function myStructureId() {
      return userDoc().structureId;
    }

    function sameStructure(structureId) {
      return myStructureId() != null && myStructureId() == structureId;
    }

    function structureOwnedByPartner(structureId) {
      return structureId is string
        && exists(/databases/$(database)/documents/structures/$(structureId))
        && get(/databases/$(database)/documents/structures/$(structureId)).data
            .get("partnerId", null) == myPartnerId();
    }

    function bootstrapOpen() {
      return !exists(/databases/$(database)/documents/config/initialized);
    }

    function inviteDoc(token) {
      return get(/databases/$(database)/documents/invites/$(token)).data;
    }

    function structureInviteDoc(token) {
      return get(/databases/$(database)/documents/structureInvites/$(token)).data;
    }

    function isNumber(value) {
      return value is int || value is float;
    }

    // Plafond = billing.seats si présent, sinon seatsMax du lien (évite crash si structure absente)
    function seatCap(structureId, inviteToken) {
      let billingSeats = exists(/databases/$(database)/documents/structures/$(structureId))
        ? get(/databases/$(database)/documents/structures/$(structureId)).data
            .get('billing', {}).get('seats', null)
        : null;
      let inviteSeats = exists(/databases/$(database)/documents/structureInvites/$(inviteToken))
        ? get(/databases/$(database)/documents/structureInvites/$(inviteToken)).data
            .get('seatsMax', null)
        : null;
      return isNumber(billingSeats)
        ? billingSeats
        : (isNumber(inviteSeats) ? inviteSeats : 1);
    }

    function seatsUsedOf(token) {
      return structureInviteDoc(token).get('seatsUsed', 0);
    }

    function structureHasOpenSeat(structureId) {
      let token = get(/databases/$(database)/documents/structures/$(structureId)).data.inviteToken;
      return token is string
        && exists(/databases/$(database)/documents/structureInvites/$(token))
        && isNumber(seatsUsedOf(token))
        && seatsUsedOf(token) < seatCap(structureId, token);
    }

    function validInviteClaim() {
      return request.resource.data.inviteToken is string
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteToken))
        && inviteDoc(request.resource.data.inviteToken).status == "pending"
        && inviteDoc(request.resource.data.inviteToken).email == request.auth.token.email
        && inviteDoc(request.resource.data.inviteToken).role == request.resource.data.role
        && inviteDoc(request.resource.data.inviteToken).structureId == request.resource.data.structureId
        && (
          request.resource.data.role == "rh"
          || structureHasOpenSeat(request.resource.data.structureId)
        );
    }

    match /config/{docId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && docId == "initialized"
        && bootstrapOpen()
        && allowedSuperAdminEmail();
      allow update, delete: if isSuperAdmin();
    }

    // Isolation OF : chaque partenaire ne lit que SON document (pas les autres OF)
    match /partners/{partnerId} {
      allow read: if isSuperAdmin()
        || (isPartner() && partnerId == myPartnerId());
      allow create, update, delete: if isSuperAdmin();
    }

    match /firstLogin/{email} {
      // Lu avant toute connexion : sinon « Première connexion » échoue tout de suite.
      allow get: if true;
      allow create, update: if isSuperAdmin()
        || (isRh()
            && request.resource.data.structureId == myStructureId()
            && request.resource.data.role == "employee"
            && request.resource.data.status == "pending"
            && request.resource.data.email == email)
        || (isPartner()
            && request.resource.data.status == "pending"
            && request.resource.data.email == email
            && (
              (request.resource.data.role == "rh"
                && request.resource.data.structureId is string
                && structureOwnedByPartner(request.resource.data.structureId))
              || (request.resource.data.role == "employee"
                && request.resource.data.structureId is string
                && structureOwnedByPartner(request.resource.data.structureId))
            ));
      allow delete: if isSuperAdmin()
        || (signedIn() && request.auth.token.email == email)
        || (isRh() && resource.data.structureId == myStructureId())
        || (isPartner()
            && resource.data.structureId is string
            && structureOwnedByPartner(resource.data.structureId));
    }

    match /structureInvites/{token} {
      allow get: if true;
      allow create: if isSuperAdmin()
        || (isPartner()
            && request.resource.data.structureId is string
            && structureOwnedByPartner(request.resource.data.structureId)
            && isNumber(request.resource.data.seatsMax)
            && isNumber(request.resource.data.seatsUsed)
            && request.resource.data.seatsUsed >= 0
            && request.resource.data.seatsUsed <= request.resource.data.seatsMax)
        || (isRh()
            && request.resource.data.structureId == myStructureId()
            && isNumber(request.resource.data.seatsMax)
            && request.resource.data.seatsMax == seatCap(myStructureId(), token)
            && isNumber(request.resource.data.seatsUsed)
            && request.resource.data.seatsUsed >= 0
            && request.resource.data.seatsUsed <= request.resource.data.seatsMax);
      allow update: if isSuperAdmin()
        // RH : seatsMax calé sur l'offre admin, seatsUsed intouchable (anti-triche)
        || (isRh()
            && resource.data.structureId == myStructureId()
            && request.resource.data.structureId == resource.data.structureId
            && isNumber(request.resource.data.seatsMax)
            && request.resource.data.seatsMax == seatCap(myStructureId(), token)
            && request.resource.data.seatsUsed == resource.data.seatsUsed)
        || (isPartner()
            && structureOwnedByPartner(resource.data.structureId)
            && request.resource.data.structureId == resource.data.structureId)
        // Inscription collaborateur / RH via lien : +1 siège
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["seatsUsed"])
            && isNumber(request.resource.data.seatsUsed)
            && isNumber(resource.data.seatsUsed)
            && request.resource.data.seatsUsed == resource.data.seatsUsed + 1
            && request.resource.data.seatsUsed <= seatCap(resource.data.structureId, token))
        // RH : -1 siège uniquement après départ d'un collaborateur
        || (isRh()
            && resource.data.structureId == myStructureId()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["seatsUsed"])
            && isNumber(request.resource.data.seatsUsed)
            && isNumber(resource.data.seatsUsed)
            && request.resource.data.seatsUsed == resource.data.seatsUsed - 1
            && request.resource.data.seatsUsed >= 0);
      allow delete: if isSuperAdmin();
    }

    // Isolation OF : structures uniquement si partnerId == mon OF (pas les clients d'un autre OF)
    match /structures/{structureId} {
      allow read: if isSuperAdmin()
        || (hasProfile() && sameStructure(structureId))
        || (isPartner() && resource.data.get("partnerId", null) == myPartnerId());
      allow create: if isSuperAdmin()
        || (isPartner()
            && request.resource.data.partnerId == myPartnerId()
            && request.resource.data.status == "active");
      allow update: if isSuperAdmin()
        || (isRh()
            && sameStructure(structureId)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["inviteToken", "companyModule"]))
        || (isPartner()
            && resource.data.partnerId == myPartnerId()
            && request.resource.data.partnerId == myPartnerId());
      allow delete: if isSuperAdmin();

      // Preuves FOAD archivées (rétention année + 3) après retrait d'un accès
      match /archivedProofs/{userId} {
        allow read: if isSuperAdmin()
          || (isRh() && sameStructure(structureId))
          || (isPartner() && structureOwnedByPartner(structureId));
        allow create, update: if isSuperAdmin()
          || (isRh() && sameStructure(structureId))
          || (isPartner() && structureOwnedByPartner(structureId));
        allow delete: if isSuperAdmin();
      }
    }

    match /invites/{token} {
      // Le token est le secret (lien d'invitation)
      // Collaborateurs : uniquement le lien permanent structure (/rejoindre) — pas d'invite perso RH
      allow get: if true;
      allow list: if isSuperAdmin() || isRh();
      allow create: if isSuperAdmin()
        || (isRh()
            && request.resource.data.structureId == myStructureId()
            && request.resource.data.role == "rh");
      allow update, delete: if isSuperAdmin()
        || (isRh() && resource.data.structureId == myStructureId())
        || (signedIn()
            && resource.data.email == request.auth.token.email
            && resource.data.status == "pending");
    }

    // Leads du formulaire /interventions — écriture via Admin SDK uniquement
    match /contactLeads/{leadId} {
      allow read: if isSuperAdmin();
      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]);
      allow create, delete: if false;
    }

    match /users/{userId} {
      allow create: if signedIn() && (
        (request.auth.uid == userId
          && allowedSuperAdminEmail()
          && request.resource.data.email == "jonathan.seroussi.92100@gmail.com"
          && request.resource.data.role == "super_admin"
          && request.resource.data.structureId == null
          && bootstrapOpen())
        // Première connexion via invitation
        || (request.auth.uid == userId
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.role in ["rh", "employee"]
            && validInviteClaim())
        // Plus d'auto-inscription libre via /rejoindre : seul le RH crée les accès (firstLogin)
        || (isSuperAdmin()
            && request.resource.data.role in ["rh", "employee", "partner"]
            && request.resource.data.email is string)
        || (signedIn()
            && request.auth.uid == userId
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.status == "active"
            && request.resource.data.role in ["rh", "employee"]
            && exists(/databases/$(database)/documents/firstLogin/$(request.auth.token.email))
            && get(/databases/$(database)/documents/firstLogin/$(request.auth.token.email)).data.status == "pending"
            && get(/databases/$(database)/documents/firstLogin/$(request.auth.token.email)).data.role == request.resource.data.role
            && get(/databases/$(database)/documents/firstLogin/$(request.auth.token.email)).data.structureId == request.resource.data.structureId)
        || (isRh()
            && request.resource.data.structureId == myStructureId()
            && request.resource.data.role == "rh"
            && request.resource.data.email is string)
        || (isRh()
            && request.resource.data.structureId == myStructureId()
            && request.resource.data.role == "employee"
            && request.resource.data.email is string
            && structureHasOpenSeat(myStructureId()))
        || (isPartner()
            && request.resource.data.role in ["rh", "employee"]
            && request.resource.data.structureId is string
            && structureOwnedByPartner(request.resource.data.structureId)
            && request.resource.data.email is string
            && (request.resource.data.role == "rh"
                || structureHasOpenSeat(request.resource.data.structureId)))
        // Activation compte partenaire (firstLogin)
        || (signedIn()
            && request.auth.uid == userId
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.role == "partner"
            && request.resource.data.partnerId is string
            && request.resource.data.status == "active"
            && exists(/databases/$(database)/documents/firstLogin/$(request.auth.token.email))
            && get(/databases/$(database)/documents/firstLogin/$(request.auth.token.email)).data.status == "pending"
            && get(/databases/$(database)/documents/firstLogin/$(request.auth.token.email)).data.role == "partner"
            && get(/databases/$(database)/documents/firstLogin/$(request.auth.token.email)).data.partnerId
              == request.resource.data.partnerId)
      );

      // Isolation OF : users seulement via structures rattachées à mon partnerId
      allow read: if isSuperAdmin()
        || (signedIn() && request.auth.uid == userId)
        || (isRh() && resource.data.structureId == myStructureId())
        || (isPartner()
            && resource.data.structureId is string
            && structureOwnedByPartner(resource.data.structureId));

      allow update: if isSuperAdmin()
        // Auto-update (progression, attestation…) : pas de changement de rôle / rattachement
        || (signedIn()
            && request.auth.uid == userId
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(["role", "structureId", "partnerId"]))
        || (isRh()
            && resource.data.structureId == myStructureId()
            && request.resource.data.structureId == myStructureId()
            && request.resource.data.role in ["employee", "rh"])
        || (isPartner()
            && resource.data.structureId is string
            && structureOwnedByPartner(resource.data.structureId)
            && request.resource.data.structureId == resource.data.structureId
            && request.resource.data.role in ["employee", "rh"]);

      allow delete: if isSuperAdmin()
        || (isRh() && resource.data.structureId == myStructureId())
        || (isPartner()
            && resource.data.structureId is string
            && structureOwnedByPartner(resource.data.structureId))
        || (signedIn()
            && userId != request.auth.uid
            && resource.data.email == request.auth.token.email
            && resource.data.status == "invited");

      match /progress/{docId} {
        allow read: if isSuperAdmin()
          || (signedIn() && request.auth.uid == userId)
          || (isRh() && get(/databases/$(database)/documents/users/$(userId)).data.structureId == myStructureId())
          || (isPartner()
              && get(/databases/$(database)/documents/users/$(userId)).data.structureId is string
              && structureOwnedByPartner(
                get(/databases/$(database)/documents/users/$(userId)).data.structureId));

        allow create, update: if isSuperAdmin()
          || (signedIn() && request.auth.uid == userId);

        allow delete: if isSuperAdmin()
          || (isRh()
              && get(/databases/$(database)/documents/users/$(userId)).data.structureId == myStructureId())
          || (isPartner()
              && get(/databases/$(database)/documents/users/$(userId)).data.structureId is string
              && structureOwnedByPartner(
                get(/databases/$(database)/documents/users/$(userId)).data.structureId));
      }

      match /certificates/{certId} {
        allow read: if isSuperAdmin()
          || (signedIn() && request.auth.uid == userId)
          || (isRh() && get(/databases/$(database)/documents/users/$(userId)).data.structureId == myStructureId())
          || (isPartner()
              && get(/databases/$(database)/documents/users/$(userId)).data.structureId is string
              && structureOwnedByPartner(
                get(/databases/$(database)/documents/users/$(userId)).data.structureId));

        allow create: if isSuperAdmin()
          || (signedIn() && request.auth.uid == userId);

        allow update, delete: if isSuperAdmin()
          || (isRh()
              && get(/databases/$(database)/documents/users/$(userId)).data.structureId == myStructureId())
          || (isPartner()
              && get(/databases/$(database)/documents/users/$(userId)).data.structureId is string
              && structureOwnedByPartner(
                get(/databases/$(database)/documents/users/$(userId)).data.structureId));
      }
    }
  }
}
